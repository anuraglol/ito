{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ito-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ito-db",
      "database_id": "177191cb-8f01-4583-9caf-6f03f6ad348a",
      "remote": false,
      "migrations_dir": "./drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["SyncRoom"],
    },
  ],
}
